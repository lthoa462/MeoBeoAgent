# Provider mặc định khi mở CLI: openai hoặc gemini (đổi trong lúc chạy bằng /openai, /gemini)
MEOBEO_PROVIDER=openai

# --- OpenAI (Chat Completions) ---
OPENAI_API_KEY=
# Tên model bất kỳ mà tài khoản của bạn dùng được (xem https://platform.openai.com/docs/models)
OPENAI_MODEL=
# Tuỳ chọn: đổi sang gateway tương thích Chat Completions (OpenRouter, Groq, Ollama...)
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Google Gemini ---
GEMINI_API_KEY=
# Tên model Gemini hỗ trợ function calling (xem https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
