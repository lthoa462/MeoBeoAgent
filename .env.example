# Provider mặc định khi mở CLI: openai hoặc gemini (đổi trong lúc chạy bằng /openai, /gemini)
MEOBEO_PROVIDER=openai

# Suy nghĩ: on (hiện tiến trình tư duy) | hidden (suy nghĩ nhưng ẩn nội dung) | off (model không hỗ trợ)
MEOBEO_THINKING=on

# --- OpenAI ---
OPENAI_API_KEY=
# Tên model bất kỳ mà tài khoản của bạn dùng được (xem https://platform.openai.com/docs/models).
# Muốn thấy suy nghĩ thì chọn model reasoning.
OPENAI_MODEL=
# responses (mặc định, thấy được suy nghĩ) | chat (Chat Completions, cho gateway như OpenRouter/Ollama)
# OPENAI_API_STYLE=responses
# Mức suy nghĩ: low | medium | high (bỏ trống = mặc định của model)
# OPENAI_REASONING_EFFORT=medium
# Tuỳ chọn: đổi sang gateway tương thích Chat Completions (OpenRouter, Groq, Ollama...)
# OPENAI_BASE_URL=https://api.openai.com/v1
# Model embedding cho RAG (mặc định text-embedding-3-small)
# OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Google Gemini ---
GEMINI_API_KEY=
# Tên model Gemini hỗ trợ function calling (xem https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=
# Mức suy nghĩ cho Gemini 3: low | high (bỏ trống với Gemini 2.5)
# GEMINI_THINKING_LEVEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
# Model embedding cho RAG (mặc định gemini-embedding-001)
# GEMINI_EMBEDDING_MODEL=gemini-embedding-001

# Thư mục tài liệu cho RAG (mặc định ./library)
# MEOBEO_LIBRARY=library
