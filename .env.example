# =============================================================================
# MeoBeo – cấu hình. Sao chép thành .env ở thư mục gốc repo: cp .env.example .env
# .env chứa bí mật (API key, client secret): KHÔNG commit (đã có trong .gitignore).
# Một file .env dùng chung cho web (Next.js), backend, bot Teams và teams:package.
# Biến để trống hoặc giá trị không hợp lệ = dùng mặc định. Biến đặt trên dòng
# lệnh luôn thắng giá trị trong .env.
# =============================================================================

# ----------------------------------------------------------------------------
# Mô hình AI
# ----------------------------------------------------------------------------
# openai | gemini | mock
# mock: trả lời soạn sẵn, không cần API key, không gọi mạng – chỉ để chạy thử/test.
LLM_PROVIDER=openai

# --- OpenAI (khi LLM_PROVIDER=openai) ---
OPENAI_API_KEY=
# Bắt buộc. Tên model bất kỳ mà tài khoản của bạn dùng được và hỗ trợ gọi tool
# (xem https://platform.openai.com/docs/models).
OPENAI_MODEL=
# Mức suy luận cho model reasoning, ví dụ low | medium | high. Trống = mặc định của model.
OPENAI_REASONING_EFFORT=
# Tuỳ chọn: endpoint tương thích OpenAI Responses API. Trống = https://api.openai.com/v1
OPENAI_BASE_URL=

# --- Google Gemini (khi LLM_PROVIDER=gemini) ---
GEMINI_API_KEY=
# Bắt buộc. Tên model Gemini hỗ trợ function calling
# (xem https://ai.google.dev/gemini-api/docs/models).
GEMINI_MODEL=
# Tuỳ chọn. Trống = endpoint mặc định của Google.
GEMINI_BASE_URL=

# Tuỳ chọn: model rẻ/nhanh hơn (cùng provider) cho các worker đọc từng phần hội
# thoại dài (bước map). Trống = dùng OPENAI_MODEL / GEMINI_MODEL.
WORKER_MODEL=

# ----------------------------------------------------------------------------
# App Entra ID + bot Teams (một app registration dùng cho cả bot và web)
# `teams app create ... --env .env` tự ghi CLIENT_ID, CLIENT_SECRET, TENANT_ID.
# ----------------------------------------------------------------------------
# Application (client) ID – cũng là bot id trong manifest Teams.
CLIENT_ID=
# Client secret của app (bot dùng để xác thực với Bot Framework và lấy token
# app-only đọc tin nhắn qua quyền RSC). Bí mật – không chia sẻ.
CLIENT_SECRET=
# Directory (tenant) ID. Cần khi app là single-tenant; web cũng dùng làm tenant
# đăng nhập nếu NEXT_PUBLIC_AZURE_TENANT_ID để trống.
TENANT_ID=

# ----------------------------------------------------------------------------
# Giao diện web (đăng nhập Microsoft bằng MSAL, quyền delegated)
# Hai giá trị này được nhúng vào JavaScript gửi cho trình duyệt: chỉ là định danh
# công khai, không bao giờ đặt bí mật vào biến NEXT_PUBLIC_*.
# Đổi xong phải chạy lại `npm run dev` / `npm run build`.
# ----------------------------------------------------------------------------
# Trống = dùng CLIENT_ID.
NEXT_PUBLIC_AZURE_CLIENT_ID=
# Trống = dùng TENANT_ID; nếu cả hai trống thì đăng nhập qua "organizations".
NEXT_PUBLIC_AZURE_TENANT_ID=

# Địa chỉ https công khai của app (ví dụ devtunnel https://abc123-3000.asse.devtunnels.ms).
# Dùng trong lời hướng dẫn của bot (chat 1:1) và bởi `npm run teams:package`
# (developer URL, validDomains). Không có dấu / ở cuối.
WEB_URL=

# ----------------------------------------------------------------------------
# Giới hạn và hành vi
# ----------------------------------------------------------------------------
# Múi giờ khi không biết múi giờ người dùng (web lấy từ trình duyệt; bot Teams
# dùng múi giờ Teams gửi kèm tin nhắn nếu có). Tên IANA.
DEFAULT_TIMEZONE=Asia/Ho_Chi_Minh
# Đọc lùi tối đa bao nhiêu ngày (1–30). Trần cứng 30 ngày: giá trị lớn hơn bị bỏ qua.
MAX_LOOKBACK_DAYS=30
# Khoảng thời gian mặc định khi yêu cầu không nói rõ (giờ, 1–720).
DEFAULT_LOOKBACK_HOURS=24
# Số tin nhắn tối đa đọc cho một yêu cầu (50–20000); vượt quá thì giữ các tin mới nhất và báo bị cắt.
MAX_MESSAGES=3000
# Số token ước tính cho mỗi phần hội thoại giao cho một worker (1000–200000).
CHUNK_TOKENS=12000
# Số worker đọc song song cho mỗi chuyên gia (1–16).
MAP_CONCURRENCY=4
# Giữ bản hội thoại đã đọc trong RAM bao lâu để trả lời câu hỏi tiếp theo (ms, 0–3600000).
# 0 = chỉ giữ trong một lượt trả lời. Không bao giờ ghi ra đĩa.
TRANSCRIPT_CACHE_TTL_MS=600000
# Phiên hỏi đáp (lịch sử trong RAM) bị xoá sau bao lâu không dùng (ms, 60000–86400000).
SESSION_TTL_MS=1800000
# Số phiên giữ cùng lúc; vượt quá thì bỏ phiên lâu nhất không dùng.
MAX_SESSIONS=200

# 1 = chế độ demo: một nhóm chat giả lập, bỏ qua đăng nhập Microsoft. Chỉ để chạy thử
# trên máy mình – đừng bật trên server công khai.
DEMO_MODE=

# ----------------------------------------------------------------------------
# Chạy cục bộ / đóng gói
# ----------------------------------------------------------------------------
# Cổng cho `npm run serve` (backend + bot, không có giao diện). Mặc định 3978.
# `npm run dev` / `npm start` (Next.js) chạy ở cổng 3000.
# PORT=3978

# NGUY HIỂM – chỉ dùng khi thử bot trên máy với Microsoft 365 Agents Playground:
# tắt kiểm tra token của Bot Framework, ai cũng gửi được request tới /api/messages.
# Không bao giờ bật trên server có địa chỉ công khai (kể cả devtunnel).
# DANGEROUSLY_ALLOW_UNAUTHENTICATED_REQUESTS=true

# Tuỳ chọn: GUID của app Teams trong manifest. Trống = `npm run teams:package` tự tạo
# một lần và giữ trong apps/teams-app/build/.app-id. Nếu đã tạo app bằng
# `teams app create`, đặt bằng "Teams App ID" mà CLI in ra để cập nhật đúng app đó.
TEAMS_APP_ID=
# Tuỳ chọn: phiên bản manifest (semver). Trống = version trong package.json gốc.
# Tăng mỗi lần tải lại gói đã sửa lên Teams.
TEAMS_APP_VERSION=
